{
  "info": {
    "name": "Biblioteca",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Seis endpoints del ejercicio práctico 1.2. Ejecutar en orden con servidor recién iniciado."
  },
  "item": [
    {
      "name": "1. GET /libros",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/libros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "libros"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Tres libros iniciales\", function () { pm.expect(pm.response.json()).to.have.length(3); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. GET /libros/2",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/libros/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "libros",
            "2"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Libro correcto\", function () { pm.expect(pm.response.json().id).to.eql(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. POST /libros",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/libros",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "libros"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Pedro Páramo\",\n  \"autor\": \"Rulfo\",\n  \"disponible\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Location correcto\", function () { pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/libros/4\"); });",
              "pm.test(\"ID creado\", function () { pm.expect(pm.response.json().id).to.eql(4); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. PUT /libros/1",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/libros/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "libros",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Cien años de soledad (edición revisada)\",\n  \"autor\": \"García Márquez\",\n  \"disponible\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. PATCH /libros/2",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/libros/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "libros",
            "2"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"disponible\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Conserva título\", function () { pm.expect(pm.response.json().titulo).to.eql(\"El túnel\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. DELETE /libros/3",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/libros/3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "libros",
            "3"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Estado 204\", function () { pm.response.to.have.status(204); });",
              "pm.test(\"Respuesta sin cuerpo\", function () { pm.expect(pm.response.text()).to.eql(\"\"); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ]
}