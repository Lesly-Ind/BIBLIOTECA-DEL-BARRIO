              "\r",
              "\r",
              "pm.test(\"GET libros devuelve 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta contiene una lista de libros\", function () {\r",
