      "name": "GET - Filtrar libros por autor",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "\r",
              "pm.test(\"GET por autor devuelve 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Se encontró un libro del autor Rulfo\", function () {\r",
              "    const libros = pm.response.json();\r",
              "    pm.expect(libros).to.be.an(\"array\");\r",
              "    pm.expect(libros.length).to.be.above(0);\r",
              "    libros.forEach(function (libro) {\r",
              "        pm.expect(libro.autor).to.include(\"Rulfo\");\r",
              "    });\r",
              "});\r",
              ""
